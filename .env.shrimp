# The shrimp-farm demo profile (CHG-058; dev only, R011). The make *-shrimp targets apply
# it as process environment (scripts/with_env.py), so it overrides .env for those commands
# only. No secrets: GEMINI_API_KEY and SESSION_SECRET come from .env, which is never edited.
# With DEMO_AI blank and a key in .env, the worker calls Gemini (live and billed).
APP_CONFIG_PATH=config.shrimp.yaml
MAIL_SOURCE=eml_folder
TEST_INBOX_PATH=./fixtures/shrimp_inbox
DATABASE_PATH=./data/shrimp.db
DATA_DIR=./data/shrimp-files
TRACE_DIR=./traces/shrimp
DEMO_NOW=2026-10-19T09:00:00+05:30
DEMO_AI=
FIXTURE_REPLIES_PATH=
# No owner alert email leaves the machine in a demo: alerts wait unsent.
SMTP_HOST=
