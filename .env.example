# Copy to .env and fill in. .env is git-ignored.

GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/gmail/callback
FERNET_KEY=
# Signs the web login cookie; the app refuses to start without it. Make one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# Set true behind https so the session cookie is marked Secure.
COOKIE_SECURE=false
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM=
APP_BASE_URL=http://localhost:8000
DATABASE_PATH=./data/cashflow.db
DATA_DIR=./data/files
TRACE_DIR=./traces
MAIL_SOURCE=eml_folder
TEST_INBOX_PATH=./fixtures/test_inbox
# Demo logins created by `make seed` / `make reseed` (owner@example.test, helper@example.test).
# These are dev defaults for a local demo only; set your own anywhere else.
SEED_OWNER_PASSWORD=owner-demo-pass
SEED_HELPER_PASSWORD=helper-demo-pass
# A fixed "now" for the web app and `make seed`, to demo the worked example on its
# own Monday: DEMO_NOW=2026-10-12T09:00:00+05:30. Blank means real time.
DEMO_NOW=
# With DEMO_NOW set, moving the demo forward: make demo-time T=2026-10-15T09:00:00+05:30
# (or the form on Settings). DEMO_AI=fixtures has the worker answer from the test inbox's
# canned replies, never Gemini; the app then shows a demo banner.
DEMO_AI=
